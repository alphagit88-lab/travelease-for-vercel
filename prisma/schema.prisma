datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tour {
  id          Int      @id @default(autoincrement())
  title       String
  duration    String   // e.g. "4 Nights / 5 Days"
  overview    String?
  highlights  String[] // array of short strings
  itinerary   Json?    // [{day: "Day 1", title: "...", desc: "..."}, ...]
  inclusions  String[]
  exclusions  String[]
  price       Float    // per person USD
  images      String[] // URLs or relative paths
  routeMapUrl String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
